{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "robank-frontend",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "robank-frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robank-db",
      "database_id": "b90cabdf-2186-41c5-b5b5-f01910812bd6",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "robank.co",
      "custom_domain": true,
      "zone_name": "robank.co"
    }
  ]
}
